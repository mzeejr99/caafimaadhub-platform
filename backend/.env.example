# CaafimaadHub Backend Environment Configuration Example
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database Configuration ('sqlite' for embedded zero-config, 'mysql' for MySQL / XAMPP)
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=caafimaadhub
DB_USER=root
DB_PASSWORD=

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_token_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# SMS Provider Configuration ('MOCK', 'AFRICASTALKING', 'TWILIO', 'HORMUUD')
SMS_PROVIDER=MOCK
SMS_API_KEY=mock_key
SMS_SENDER_ID=CaafimaadHub

# File Upload Settings
MAX_FILE_SIZE_MB=15
UPLOAD_DIR=uploads
